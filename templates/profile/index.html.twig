{% extends 'base.html.twig' %}

{% block title %}Mon profil — Sftontine{% endblock %}

{% block body %}
    <main style="max-width: 40rem; margin: 4rem auto; font-family: system-ui, sans-serif;">
        <h1>Mon profil</h1>

        <dl>
            <dt>Email</dt>
            <dd>{{ user.email ?? 'Non renseigné' }}</dd>

            <dt>Wallet</dt>
            <dd>
                <a href="{{ base_explorer_url }}/address/{{ user.walletAddress }}" target="_blank" rel="noopener">
                    {{ user.walletAddress }}
                </a>
            </dd>
        </dl>

        <div style="margin: 2rem 0;">
            {{ component('VaultPositionDashboard') }}
        </div>

        <div style="margin: 2rem 0;" {{ react_component('VaultDeposit', {
            appId: privy_app_id,
            clientId: privy_app_client_id,
            vaultAddress: vault_address,
            usdcAddress: usdc_address,
            gdaForwarderAddress: gda_forwarder_address,
        }) }}></div>

        <turbo-mercure-stream-source src="{{ mercure(['deposit_transaction/' ~ user.walletAddress]) }}"></turbo-mercure-stream-source>
        <div id="deposit-transaction-status" style="margin: 2rem 0; border: 1px solid #ddd; border-radius: 8px; padding: 1rem; max-width: 28rem;">
            {% include 'deposit/_transaction_status_content.html.twig' %}
        </div>

        <div {{ react_component('PrivyLogout') }}></div>
    </main>
{% endblock %}
