# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 4

[**/{Dockerfile,Caddyfile,*.sh}]
indent_style = tab

[{compose.*yaml,.devcontainer/compose.*yaml,.github/**/*.yaml}]
indent_size = 2

[**.md]
indent_size = unset
indent_style = unset

# Symfony recipe XML files align attributes, not multiple-of-4 padding
[*.xml]
indent_size = unset
