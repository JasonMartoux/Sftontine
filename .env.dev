# PRIVY_APP_ID / PRIVY_APP_CLIENT_ID / PRIVY_APP_SECRET / PRIVY_JWKS_ENDPOINT / PRIVY_VERIFICATION_KEY
# ne sont volontairement PAS redéclarés ici : .env.dev se charge après .env.local, donc les
# redéclarer (même vides) écraserait les vraies valeurs. Placeholders dans .env, valeurs réelles
# dans .env.local (jamais commit).
BASE_EXPLORER_URL=https://basescan.org
