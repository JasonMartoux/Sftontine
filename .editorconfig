# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 2

# PHP follows PSR-12 (4 spaces), enforced by php-cs-fixer
[*.php]
indent_size = 4

[**/{Dockerfile,Caddyfile,*.sh}]
indent_style = space

[**.md]
indent_size = unset
indent_style = unset

# Symfony recipe XML files align attributes, not a fixed padding grid
[*.xml]
indent_size = unset

[Makefile]
indent_style = tab
